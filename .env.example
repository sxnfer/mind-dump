# Copy to .env and fill in real values. .env is git-ignored; never commit it.

# Postgres password for the mind_dump user. Use letters and digits only (it goes into a URL).
# Generate one:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Optional. Port for Postgres on your Mac's loopback (default 5432). Change it if 5432 is taken.
DB_PORT=

# Optional. Port for the API on your Mac's loopback (default 8000). Change it if 8000 is taken.
API_PORT=

# ---------- AI models (D8). All optional. ----------
# Without VOYAGE_API_KEY, items are still saved, read and chunked, and keyword search
# works; chunks just have no vectors (no search by meaning). Add the key later, then run
#   docker compose exec worker python -m mind_dump.embed_missing
# Without ANTHROPIC_API_KEY, everything works except images, which end in "error" until
# the key is set and they are re-run.
# Check both keys:  docker compose exec worker python -m mind_dump.check_models
# Text leaves your Mac for these two APIs when the keys are set.

# Embeddings (search by meaning). Get a key at https://dashboard.voyageai.com (API keys).
VOYAGE_API_KEY=

# Claude (image descriptions, and answers: POST /ask). Get a key at
# https://platform.claude.com (Settings, API keys). Without it, asking answers 503.
ANTHROPIC_API_KEY=

# Optional. Model names; empty means the defaults voyage-4 and claude-opus-5-5.
# Changing EMBEDDING_MODEL means re-embedding everything: run embed_missing after it.
EMBEDDING_MODEL=
LLM_MODEL=

# ---------- Answers (M5, D9). All optional. ----------
# How much Claude thinks per answer: low, medium (default), high, xhigh or max.
# Higher means slower and dearer answers.
LLM_EFFORT=
# Model calls that may use tools (search, get_item) per question before the agent must
# answer with what it has (default 6).
AGENT_MAX_TURNS=

# ---------- Cost cap and rate limit (D39). All optional. ----------
# Every model call is recorded with an ESTIMATED cost (GET /usage). When today's total
# (UTC day) reaches the cap, asking answers 429 until midnight UTC. Default 2.00.
DAILY_COST_CAP_USD=
# Questions per 60 seconds before asking answers 429 (default 10).
ASK_RATE_PER_MINUTE=
# Voyage AI's price in US dollars per million tokens, used for the cost estimate.
# Default 0.06, the list price of voyage-4 (docs.voyageai.com/docs/pricing). Change it
# if you change EMBEDDING_MODEL or the price changes.
VOYAGE_PRICE_PER_MTOK=
# Optional JSON to change or add model prices (US dollars per million tokens), e.g.
# {"claude-opus-5-5": {"input": 4, "output": 20, "cache_write": 5, "cache_read": 0.2}}
MODEL_PRICES=
