# Copy to .env and fill in real values. .env is git-ignored; never commit it.

# Postgres password for the mind_dump user. Use letters and digits only (it goes into a URL).
# Generate one:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Optional. Port for Postgres on your Mac's loopback (default 5432). Change it if 5432 is taken.
DB_PORT=
