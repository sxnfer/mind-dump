# Copy to .env and fill in real values. .env is git-ignored; never commit it.

# Postgres password for the mind_dump user. Use letters and digits only (it goes into a URL).
# Generate one:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Optional. Port for Postgres on your Mac's loopback (default 5432). Change it if 5432 is taken.
DB_PORT=

# Optional. Port for the API on your Mac's loopback (default 8000). Change it if 8000 is taken.
API_PORT=

# ---------- AI models (D8). All optional. ----------
# Without VOYAGE_API_KEY, items are still saved, read and chunked, and keyword search
# works; chunks just have no vectors (no search by meaning). Add the key later, then run
#   docker compose exec worker python -m mind_dump.embed_missing
# Without ANTHROPIC_API_KEY, everything works except images, which end in "error" until
# the key is set and they are re-run.
# Check both keys:  docker compose exec worker python -m mind_dump.check_models
# Text leaves your Mac for these two APIs when the keys are set.

# Embeddings (search by meaning). Get a key at https://dashboard.voyageai.com (API keys).
VOYAGE_API_KEY=

# Claude (image descriptions now; answers later). Get a key at
# https://platform.claude.com (Settings, API keys).
ANTHROPIC_API_KEY=

# Optional. Model names; empty means the defaults voyage-4 and claude-opus-5-5.
# Changing EMBEDDING_MODEL means re-embedding everything: run embed_missing after it.
EMBEDDING_MODEL=
LLM_MODEL=
